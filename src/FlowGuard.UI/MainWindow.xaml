<ui:FluentWindow x:Class="FlowGuard.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:vm="clr-namespace:FlowGuard.UI.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="FlowGuard"
                 Width="1240" Height="800" MinWidth="1060" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Assets/flowguard.ico">

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="FocusPillBackground" Color="#2E60CDFF" />
        <SolidColorBrush x:Key="FocusPillForeground" Color="#99EBFF" />
        <SolidColorBrush x:Key="ThrottlePillBackground" Color="#33FCE100" />
        <SolidColorBrush x:Key="ThrottlePillForeground" Color="#FCE100" />
        <SolidColorBrush x:Key="CapPillBackground" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="CapPillForeground" Color="#E0FFFFFF" />
        <SolidColorBrush x:Key="GamePillBackground" Color="#3354D88A" />
        <SolidColorBrush x:Key="GamePillForeground" Color="#7FE8A8" />
        <SolidColorBrush x:Key="VideoPillBackground" Color="#33C08CFF" />
        <SolidColorBrush x:Key="VideoPillForeground" Color="#D7B8FF" />
        <SolidColorBrush x:Key="DownAccent" Color="#60CDFF" />
        <SolidColorBrush x:Key="UpAccent" Color="#A0E0A0" />
        <SolidColorBrush x:Key="GoodBrush" Color="#7FE8A8" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FCE100" />
        <SolidColorBrush x:Key="BadBrush" Color="#FF99A4" />

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CardDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SmallNumber" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="Width" Value="110" />
            <Setter Property="MaxDecimalPlaces" Value="0" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>

        <!-- A removable chip (games, sites, video targets). -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:NamedItem}">
            <Border CornerRadius="12" Padding="10,3,4,3" Margin="0,0,6,6"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="WindowApps24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSite}" Value="True">
                                        <Setter Property="Symbol" Value="Globe24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" ToolTip="{Binding Key}" />
                    <ui:Button Margin="4,0,0,0" Padding="4" Appearance="Transparent" BorderThickness="0"
                               Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Remove"
                               Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Fixed list columns, shared by the header and every row. -->
        <GridLength x:Key="ColIcon">36</GridLength>
        <GridLength x:Key="ColPid">96</GridLength>
        <GridLength x:Key="ColSpeed">92</GridLength>
        <GridLength x:Key="ColPriority">84</GridLength>
        <GridLength x:Key="ColLimit">104</GridLength>

        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AppRowViewModel}">
            <Grid Height="50" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColIcon}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ColPid}" />
                    <ColumnDefinition Width="{StaticResource ColSpeed}" />
                    <ColumnDefinition Width="{StaticResource ColSpeed}" />
                    <ColumnDefinition Width="{StaticResource ColPriority}" />
                    <ColumnDefinition Width="{StaticResource ColLimit}" />
                    <ColumnDefinition Width="{StaticResource ColLimit}" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open file location" Click="OnOpenFileLocation" Visibility="{Binding IsApp, Converter={StaticResource BoolToVisible}}" />
                        <MenuItem Header="Copy name" Click="OnCopyName" />
                        <Separator />
                        <MenuItem Header="Game (always first in Game mode)" IsCheckable="True" IsChecked="{Binding IsGame, Mode=OneWay}"
                                  Click="OnToggleGame" Visibility="{Binding IsApp, Converter={StaticResource BoolToVisible}}" />
                        <MenuItem Header="Video (space kept waiting in Movie mode)" IsCheckable="True" IsChecked="{Binding IsVideo, Mode=OneWay}"
                                  Click="OnToggleVideo" IsEnabled="{Binding IsEditable}" />
                        <Separator />
                        <MenuItem Header="Reset priority and limits" Click="OnResetRules" IsEnabled="{Binding IsEditable}" />
                        <MenuItem Header="Stop tracking this website" Click="OnRemoveSite" Visibility="{Binding IsSite, Converter={StaticResource BoolToVisible}}" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- Icon -->
                <Image Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Left"
                       Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                <ui:SymbolIcon Grid.Column="0" FontSize="20" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="WindowApps24" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSite}" Value="True">
                                    <Setter Property="Symbol" Value="Globe24" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>

                <!-- Name, badges, detail -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                   ToolTip="{Binding Path}" ToolTipService.ShowOnDisabled="True">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource GamePillBackground}"
                                Visibility="{Binding IsGame, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource PillText}" Text="Game" Foreground="{StaticResource GamePillForeground}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource VideoPillBackground}"
                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource PillText}" Text="Video" Foreground="{StaticResource VideoPillForeground}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource FocusPillBackground}"
                                Visibility="{Binding IsForeground, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource PillText}" Text="Focused" Foreground="{StaticResource FocusPillForeground}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource ThrottlePillBackground}"
                                Visibility="{Binding IsQosThrottled, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource PillText}" Text="Sharing" Foreground="{StaticResource ThrottlePillForeground}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource CapPillBackground}"
                                Visibility="{Binding IsCapped, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource PillText}" Text="Capped" Foreground="{StaticResource CapPillForeground}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DetailText}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding PidText}" ToolTip="{Binding PidToolTip}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="3" Text="{Binding DownText}" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQosThrottled}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ThrottlePillForeground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding UpText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:TextBox Grid.Column="5" Margin="0,0,12,0" VerticalAlignment="Center"
                            ClearButtonEnabled="False" PlaceholderText="—" TextAlignment="Center"
                            Text="{Binding RankText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            IsEnabled="{Binding IsEditable}"
                            ToolTip="Priority number: 1 is the most important, 128 the least. Empty = left alone (never slowed)." />

                <ui:TextBox Grid.Column="6" Margin="0,0,8,0" VerticalAlignment="Center"
                            ClearButtonEnabled="False" PlaceholderText="No limit"
                            Text="{Binding DownLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            IsEnabled="{Binding IsEditable}"
                            ToolTip="Download limit in KB/s (also accepts 2 MB). Leave empty for no limit." />
                <ui:TextBox Grid.Column="7" Margin="0,0,4,0" VerticalAlignment="Center"
                            ClearButtonEnabled="False" PlaceholderText="No limit"
                            Text="{Binding UpLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            IsEnabled="{Binding IsEditable}"
                            ToolTip="Upload limit in KB/s (also accepts 2 MB). Leave empty for no limit." />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RankItemTemplate" DataType="{x:Type vm:RankItem}">
            <Grid Height="38" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="ReOrderDotsVertical24" FontSize="16"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <Border Grid.Column="1" CornerRadius="4" Width="34" Height="24" HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon ArrowUp16}" ToolTip="More important"
                               Command="{Binding DataContext.MoveRankUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                    <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon ArrowDown16}" ToolTip="Less important"
                               Command="{Binding DataContext.MoveRankDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                    <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Remove the number (leave it alone)"
                               Command="{Binding DataContext.ClearRankCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FlowGuard">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/flowguard.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Tray icon: zero-size, registers itself when first rendered. -->
        <tray:NotifyIcon x:Name="TrayIcon" Grid.Row="0"
                         FocusOnLeftClick="False" MenuOnRightClick="True"
                         Icon="pack://application:,,,/Assets/flowguard.ico"
                         TooltipText="{Binding TrayToolTip}"
                         LeftClick="OnTrayLeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Open FlowGuard" FontWeight="SemiBold" Click="OnTrayOpen" />
                    <Separator />
                    <MenuItem Header="Game mode" IsCheckable="True" IsChecked="{Binding GameModeEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Movie mode" IsCheckable="True" IsChecked="{Binding MovieModeEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Smart sharing" IsCheckable="True" IsChecked="{Binding SharingEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Focus mode" IsCheckable="True" IsChecked="{Binding FocusModeEnabled, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="{Binding PauseMenuText}" Click="OnTrayPause" />
                    <MenuItem Header="Exit" Click="OnTrayExit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:InfoBar Grid.Row="1" Margin="16,0,16,12" Severity="Error" IsClosable="True"
                    Title="{Binding ErrorTitle}" Message="{Binding ErrorMessage}"
                    IsOpen="{Binding IsErrorOpen, Mode=TwoWay}" />

        <!-- Summary cards -->
        <UniformGrid Grid.Row="2" Columns="6" Margin="16,0,8,12">
            <ui:Card Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardCaption}" Text="Traffic" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" Foreground="{StaticResource DownAccent}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardValue}" Margin="0" Text="{Binding TotalDownText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Foreground="{StaticResource UpAccent}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalUpText}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardDetail}" Text="{Binding LineText}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pulse24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource CardCaption}" Text="Ping" />
                    </StackPanel>
                    <TextBlock Text="{Binding PingText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PingLevel}" Value="1">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PingLevel}" Value="2">
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PingText}" Value="—">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CardDetail}" Text="{Binding PingDetailText}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding EngineEnabled, Mode=TwoWay}"
                                         ToolTip="Pause or resume monitoring and limiting" />
                        <TextBlock Style="{StaticResource CardCaption}" Text="FlowGuard" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding EngineStatusText}" />
                    <TextBlock Style="{StaticResource CardDetail}" Text="{Binding EngineDetailText}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SharingEnabled, Mode=TwoWay}"
                                         ToolTip="Share the line by priority number: 1 first" />
                        <TextBlock Style="{StaticResource CardCaption}" Text="Smart sharing" />
                    </DockPanel>
                    <TextBlock Text="{Binding SharingStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThrottling}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ThrottlePillForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CardDetail}" Text="{Binding SharingDetailText}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding GameModeEnabled, Mode=TwoWay}"
                                         ToolTip="Your games first, with space always kept free so ping stays low" />
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" FontSize="16" Margin="0,0,6,0" Foreground="{StaticResource GamePillForeground}" />
                            <TextBlock Style="{StaticResource CardCaption}" Text="Game mode" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding GameStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GamePillForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CardDetail}" Text="{Binding GameDetailText}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MovieModeEnabled, Mode=TwoWay}"
                                         ToolTip="Keep space waiting for video so every chunk downloads at full speed" />
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Margin="0,0,6,0" Foreground="{StaticResource VideoPillForeground}" />
                            <TextBlock Style="{StaticResource CardCaption}" Text="Movie mode" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding MovieStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVideoActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource VideoPillForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CardDetail}" Text="{Binding MovieDetailText}" />
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <!-- Settings -->
        <ui:CardExpander x:Name="OptionsExpander" Grid.Row="3" Margin="16,0,16,12"
                         Icon="{ui:SymbolIcon Settings24}" ContentPadding="12,4,12,12">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Priorities, modes and settings" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Priority order, Game mode, Movie mode, websites, line speed" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>

            <TabControl x:Name="OptionsTabs" MaxHeight="330">
                <!-- Priority order -->
                <TabItem Header="Priority order">
                    <Grid Margin="4,10,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="370" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="1 gets the line first, then 2, and so on. Equal numbers share. Drag to reorder, or type a number in the list below. Apps without a number are left alone." />
                            <Grid>
                                <ListBox x:Name="RankList" ItemsSource="{Binding RankItems}" ItemTemplate="{StaticResource RankItemTemplate}"
                                         AllowDrop="True" HorizontalContentAlignment="Stretch"
                                         PreviewMouseLeftButtonDown="OnRankMouseDown" PreviewMouseMove="OnRankMouseMove"
                                         DragOver="OnRankDragOver" Drop="OnRankDrop"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <TextBlock Style="{StaticResource Hint}" Margin="8" VerticalAlignment="Top"
                                           Visibility="{Binding HasRankItems, Converter={StaticResource BoolToCollapsed}}"
                                           Text="No numbers yet. Type one in the Priority column of an app below, e.g. 1 for your game, 2 for Chrome, 3 for your downloader, 4 for Steam." />
                            </Grid>
                        </DockPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="While something more important is busy" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Never slow an app below" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <ui:NumberBox Style="{StaticResource SmallNumber}" Width="80" Minimum="1" Maximum="100000" Value="{Binding MinKBps, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Unit}" Text="KB/s" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource SettingLabel}" Text="Hold priority after an app goes quiet" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <ui:NumberBox Style="{StaticResource SmallNumber}" Width="80" Minimum="0" Maximum="600" Value="{Binding HoldSeconds, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Unit}" Text="s" />
                                </StackPanel>
                            </Grid>
                            <ui:ToggleSwitch Margin="0,10,0,0" Content="Focus mode: the app in front counts as 1" IsChecked="{Binding FocusModeEnabled, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding FocusDetailText}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Game mode -->
                <TabItem Header="Game mode">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="4,10,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:ToggleSwitch Content="Game mode" IsChecked="{Binding GameModeEnabled, Mode=TwoWay}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="While one of these games runs it always goes first, a fixed amount stays free for it, and the line is never filled completely, so packets never wait in a queue. Downloads lose only a little speed." />
                                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource ChipTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" Tag="{Binding RemoveGameCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ComboBox Width="260" IsEditable="True" ItemsSource="{Binding RunningApps}"
                                              Text="{Binding NewGameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Pick a running app or type its name, e.g. valorant.exe" />
                                    <ui:Button Margin="8,0,0,0" Content="Add game" Icon="{ui:SymbolIcon Add16}" Command="{Binding AddGameCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Tip: right-click any app in the list and choose Game." />
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Always keep free for the game" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <ui:NumberBox Style="{StaticResource SmallNumber}" Width="80" Minimum="0" Maximum="100000" Value="{Binding GameReserveKBps, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Unit}" Text="KB/s" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource SettingLabel}" Text="Never fill the line above" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <ui:NumberBox Style="{StaticResource SmallNumber}" Width="80" Minimum="0" Maximum="50" Value="{Binding GameMarginPercent, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Unit}" Text="% left free" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" IsChecked="{Binding PingGuardEnabled, Mode=TwoWay}"
                                                 Content="Ping guard: slow downloads more if the ping rises" />
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Ping address" />
                                    <ui:TextBox Width="150" ClearButtonEnabled="False"
                                                Text="{Binding PingTargetText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                ToolTip="An IP address to ping once a second, e.g. 1.1.1.1 or your game server" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Movie mode -->
                <TabItem Header="Movie mode">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="4,10,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:ToggleSwitch Content="Movie mode" IsChecked="{Binding MovieModeEnabled, Mode=TwoWay}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Videos download in chunks every few seconds. Once a video starts, space is kept waiting for the next chunk so it arrives at full speed and never buffers. When no video has played for a while, downloads get everything back." />
                                <ItemsControl ItemsSource="{Binding Platforms}" ItemsPanel="{StaticResource WrapItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PlatformOption}">
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      ToolTip="{Binding Domains}" Margin="0,0,12,4" MinWidth="120" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding CustomVideoTargets}" ItemTemplate="{StaticResource ChipTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" Tag="{Binding RemoveVideoTargetCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:TextBox Width="300" PlaceholderText="Another site or app, e.g. vlc.exe" ClearButtonEnabled="False"
                                                Text="{Binding NewVideoTargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Margin="8,0,0,0" Content="Add" Icon="{ui:SymbolIcon Add16}" Command="{Binding AddVideoTargetCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:ToggleSwitch Grid.ColumnSpan="2" Content="Learn the space from the video's own speed" IsChecked="{Binding MovieReserveAuto, Mode=TwoWay}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Style="{StaticResource SettingLabel}" Text="Or always keep" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4"
                                            IsEnabled="{Binding MovieReserveAuto, Converter={StaticResource InvertBool}}">
                                    <ui:NumberBox Style="{StaticResource SmallNumber}" Width="90" Minimum="64" Maximum="1000000" Value="{Binding MovieReserveKBps, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Unit}" Text="KB/s" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="About 1000 for 1080p, 2000 for 1440p, 3500 for 4K." />
                                <TextBlock Grid.Row="3" Style="{StaticResource SettingLabel}" Text="Release after no video for" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <ui:NumberBox Style="{StaticResource SmallNumber}" Width="90" Minimum="1" Maximum="600" Value="{Binding MovieHoldSeconds, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource Unit}" Text="s" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Websites -->
                <TabItem Header="Websites">
                    <StackPanel Margin="4,10,4,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="All browser tabs share one process, so FlowGuard recognises websites by their address instead. A tracked website gets its own row in the list below, where you can give it a priority number or a limit, in any browser." />
                        <ItemsControl ItemsSource="{Binding TrackedSites}" ItemTemplate="{StaticResource ChipTemplate}"
                                      ItemsPanel="{StaticResource WrapItems}" Tag="{Binding RemoveSiteCommand}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox Width="300" IsEditable="True" ItemsSource="{Binding SiteSuggestions}"
                                      Text="{Binding NewSiteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Pick a platform or type any web address, e.g. example.com" />
                            <ui:Button Margin="8,0,0,0" Content="Track website" Icon="{ui:SymbolIcon Add16}" Command="{Binding AddSiteCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Two tabs of the same website count as one. Sites that hide their address (Encrypted Client Hello with secure DNS) can't be recognised." />
                    </StackPanel>
                </TabItem>

                <!-- Line speed -->
                <TabItem Header="Line speed">
                    <StackPanel Margin="4,10,4,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Sharing needs to know how fast your internet is. FlowGuard learns it from the fastest total it sees (a big download is enough); you can also type it in." />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Download" Width="80" />
                            <ui:TextBox Width="120" PlaceholderText="Automatic" ClearButtonEnabled="False"
                                        Text="{Binding LineDownText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="KB/s, or e.g. 7 MB. Empty = learn automatically." />
                            <TextBlock Style="{StaticResource Unit}" Text="KB/s" />
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Upload" Width="60" Margin="32,0,12,0" />
                            <ui:TextBox Width="120" PlaceholderText="Automatic" ClearButtonEnabled="False"
                                        Text="{Binding LineUpText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="KB/s, or e.g. 1 MB. Empty = learn automatically." />
                            <TextBlock Style="{StaticResource Unit}" Text="KB/s" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LearnedLineText}" />
                            <ui:Button Content="Forget and learn again" Icon="{ui:SymbolIcon ArrowCounterclockwise16}" Command="{Binding ResetLearnedLineCommand}"
                                       ToolTip="Use after changing your internet plan" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- General -->
                <TabItem Header="General">
                    <StackPanel Margin="4,10,4,0">
                        <ui:ToggleSwitch Content="Keep running in the tray when closed or minimized" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,4" />
                        <ui:ToggleSwitch Content="Start in the tray" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button Content="Open settings folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenSettingsFolder" Margin="0,0,8,0" />
                            <ui:Button Content="Open log" Icon="{ui:SymbolIcon DocumentText24}" Click="OnOpenLog" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Local network traffic (NAS, printers, other PCs), DNS and pings are never slowed: only traffic crossing your internet line is managed." />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </ui:CardExpander>

        <!-- Toolbar -->
        <Grid Grid.Row="4" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Search apps and websites" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:ToggleSwitch Grid.Column="1" Margin="20,0,0,0" Content="Show idle apps" IsChecked="{Binding ShowIdle, Mode=TwoWay}"
                             ToolTip="Also list apps with open connections but no traffic, and apps you have rules for" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Order paused while you work in the list · " FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsSortPaused, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding ListSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Process list -->
        <Border Grid.Row="5" Margin="16,0,16,16" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="36" Margin="16,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColIcon}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ColPid}" />
                        <ColumnDefinition Width="{StaticResource ColSpeed}" />
                        <ColumnDefinition Width="{StaticResource ColSpeed}" />
                        <ColumnDefinition Width="{StaticResource ColPriority}" />
                        <ColumnDefinition Width="{StaticResource ColLimit}" />
                        <ColumnDefinition Width="{StaticResource ColLimit}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="App or website" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="PID" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="↓ Download" />
                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="↑ Upload" />
                    <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="Priority #"
                               ToolTip="1 = most important … 128. Empty = left alone." />
                    <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeader}" Text="↓ Limit (KB/s)" />
                    <TextBlock Grid.Column="7" Style="{StaticResource ColumnHeader}" Text="↑ Limit (KB/s)" />
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <ui:ListView x:Name="AppList" Grid.Row="1" Padding="4"
                          ItemsSource="{Binding Apps}"
                          ItemTemplate="{StaticResource AppRowTemplate}"
                          SelectionMode="Single"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          PreviewKeyDown="OnListPreviewKeyDown"
                          PreviewMouseMove="OnListPointerActivity"
                          PreviewMouseWheel="OnListPointerActivity">
                    <ui:ListView.ItemContainerStyle>
                        <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ui:ListView.ItemContainerStyle>
                </ui:ListView>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisible}}">
                    <ui:SymbolIcon Symbol="DataUsage24" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
