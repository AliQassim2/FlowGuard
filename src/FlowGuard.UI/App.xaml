<Application x:Class="FlowGuard.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:FlowGuard.UI"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <local:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVisible" />
            <local:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
            <local:InvertBoolConverter x:Key="InvertBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
